{
  "name": "awesome-codex-pet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cache:configure": "node scripts/configure-cloudflare-cache.mjs",
    "check:ai-access": "node scripts/check-ai-search-access.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "clean": "rm -rf .next",
    "clean:build": "node scripts/clean-next-build.mjs",
    "localize:export": "node scripts/localize-export.mjs",
    "prepare-site": "node scripts/prepare-site.mjs",
    "dev": "npm run clean && npm run prepare-site && next dev",
    "build": "npm run clean:build && npm run prepare-site && next build && npm run localize:export && npm run check:bundle && npm run check:seo",
    "build:pr": "node --test ../scripts/test/seo-keywords.test.mjs && npm run clean:build && npm run prepare-site && next build && npm run localize:export && npm run check:seo",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "next": "15.5.22",
    "postcss": "8.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.5.22",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
